[Unit]
Description=MySQL replica backup server
Documentation=https://github.com/rodericliu/backup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-server
Group=backup-server
ExecStart=/usr/local/bin/backup-server run -config /etc/backup-server/server.yaml
# EnvironmentFile=-/etc/backup-server/env   # BACKUP_DB_PASSWORD=...
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/backup-server
LogsDirectory=backup-server
# Allow binding ports below 1024 if listen is changed to :443.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
